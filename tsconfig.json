{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "declaration": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "demo", "vite*.ts"]
}
