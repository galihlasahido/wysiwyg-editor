{
  "name": "wysiwyg-editor",
  "version": "0.1.0",
  "description": "A modular, TypeScript WYSIWYG rich-text editor inspired by CKEditor 5, built on ProseMirror.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/wysiwyg-editor.js",
  "module": "./dist/wysiwyg-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wysiwyg-editor.js"
    },
    "./collab": {
      "types": "./dist/collab.d.ts",
      "import": "./dist/collab.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js"
    },
    "./epub": {
      "types": "./dist/epub.d.ts",
      "import": "./dist/epub.js"
    },
    "./docx": {
      "types": "./dist/docx.d.ts",
      "import": "./dist/docx.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs dist",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "prepack": "pnpm build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "docs:api": "npx --yes -p typedoc@0.28.20 -p typescript@5.9.3 typedoc",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "check:package": "pnpm build && pnpm dlx publint && pnpm dlx @arethetypeswrong/cli --pack . --profile esm-only --ignore-rules cjs-resolves-to-esm no-resolution"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galihlasahido/wysiwyg-editor.git"
  },
  "keywords": [
    "ckeditor-alternative",
    "collaboration",
    "docx",
    "editor",
    "epub",
    "markdown",
    "pdf",
    "prosemirror",
    "rich-text",
    "rich-text-editor",
    "track-changes",
    "typescript",
    "wysiwyg",
    "yjs"
  ],
  "dependencies": {
    "markdown-it": "^15.0.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.13.0",
    "docx": "^9.8.1",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lib0": "^0.2.119",
    "mammoth": "^1.13.0",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "ws": "^8.22.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "docx": "*",
    "jszip": "*",
    "katex": "*",
    "lib0": "*",
    "mammoth": "*",
    "mermaid": "*",
    "pdfjs-dist": "*",
    "react": "*",
    "vue": "*",
    "y-prosemirror": "*",
    "y-protocols": "*",
    "yjs": "*"
  },
  "peerDependenciesMeta": {
    "docx": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "yjs": {
      "optional": true
    },
    "y-prosemirror": {
      "optional": true
    },
    "y-protocols": {
      "optional": true
    },
    "lib0": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://galihlasahido.github.io/wysiwyg-editor/",
  "bugs": {
    "url": "https://github.com/galihlasahido/wysiwyg-editor/issues"
  },
  "author": "Galih Lasahido"
}
